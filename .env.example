# Angel One SmartAPI credentials
# Copy this file to `.env` and fill in your real values.
# `.env` is read by python-dotenv and is in .gitignore — never committed.

ANGEL_API_KEY=replace_me
ANGEL_CLIENT_CODE=replace_me
ANGEL_MPIN=replace_me
ANGEL_TOTP_SECRET=replace_me

# ----- MF Alerts (daily email digest of MF-holdings changes) -----
# Set MF_ALERT_SMTP_HOST to enable real email. Without it, the alert
# still runs but logs the email body instead of sending (dry-run mode).
MF_ALERT_SMTP_HOST=replace_me       # e.g. smtp.gmail.com
MF_ALERT_SMTP_PORT=587
MF_ALERT_SMTP_USER=replace_me       # full email address (auth user)
MF_ALERT_SMTP_PASS=replace_me       # Gmail users: use an App Password
MF_ALERT_FROM=                      # defaults to MF_ALERT_SMTP_USER
MF_ALERT_TO=                        # defaults to MF_ALERT_SMTP_USER
MF_ALERT_DRY_RUN=1                  # set to 0 to actually send email
# MF_ALERT_DISABLED=1               # uncomment to skip the scheduler

# ----- Global News Alerts (daily Telegram digest at 8:55 AM IST) -----
# To enable Telegram delivery:
#   1. Open a chat with @BotFather on Telegram
#   2. Send /newbot and follow the prompts (give it a name like
#      "Portfolio News Bot")
#   3. BotFather gives you a token like 123456:ABC-DEF... - paste below
#   4. Open a chat with your new bot and send /start (this is required
#      so the bot can send you messages)
#   5. Visit https://api.telegram.org/bot<TOKEN>/getUpdates in a browser
#      to find your chat_id, or use @userinfobot
NEWS_TELEGRAM_BOT_TOKEN=replace_me    # e.g. 123456789:ABCdefGHI...
NEWS_TELEGRAM_CHAT_ID=replace_me      # your personal chat_id (numeric)
# NEWS_DRY_RUN=1                     # set to 0 to actually send
# NEWS_DISABLED=1                    # uncomment to skip the scheduler
# NEWS_QUIET_HOURS=22-6              # don't send between 10 PM and 6 AM
