# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.DS_Store

# Secrets — never commit
.env
secrets.local.json

# Local data (runtime state) — everything under data/ is gitignored
# except the empty .gitkeep placeholders.
data/**/*.csv
data/**/*.json
data/**/*.json.*
data/**/*.db
data/**/*.db-*
data/**/*.log
data/**/*.png
data/**/*.html
data/**/*.xlsx
data/**/*.pdf
!data/.gitkeep
!data/alerts/.gitkeep
!data/alerts/*/.gitkeep
!data/cache/.gitkeep
!data/charts/.gitkeep
!data/db/.gitkeep
!data/logs/.gitkeep
!data/runs/.gitkeep
!data/scripts/.gitkeep
!data/tax_pnl/.gitkeep
!data/scripts/pre-publish-check.sh
.cache/

# SmartAPI (third-party library) hardcodes a "logs/" path relative
# to the CWD in its constructor. We can't change the vendor code,
# so we just ignore whatever it writes here.
logs/

# User portfolio lists (real holdings — never commit)
mfs.json
sgbs.json
my_tickers.txt

# AI session memory (regenerate each session — contains project context)
MEMORY.md
